{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",               
    "moduleResolution": "Node",
    "jsx": "react-jsx",               
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false
  },
  "include": ["src"]
}
